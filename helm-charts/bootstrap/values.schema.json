{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "azure": {
      "type": "object",
      "required": [
        "location"
      ]
    },
    "environment": {
      "type": "string"
    },
    "ipaffsConfig": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "secretStore": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "refreshInterval": {
          "type": "string"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretKey": {
                "type": "string"
              },
              "remoteKey": {
                "type": "string"
              }
            },
            "required": [
              "secretKey",
              "remoteKey"
            ]
          }
        },
        "certs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretKey": {
                "type": "string"
              },
              "remoteKey": {
                "type": "string"
              }
            },
            "required": [
              "secretKey",
              "remoteKey"
            ]
          }
        }
      }
    },
    "project": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "serviceBus": {
      "type": "object",
      "properties": {
        "queues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "autoDeleteOnIdle": {
                    "type": "string"
                  },
                  "defaultMessageTimeToLive": {
                    "type": "string"
                  },
                  "duplicateDetectionHistoryTimeWindow": {
                    "type": "string"
                  },
                  "enableBatchedOperations": {
                    "type": "boolean"
                  },
                  "enablePartitioning": {
                    "type": "boolean"
                  },
                  "maxSizeInMegabytes": {
                    "type": "integer"
                  },
                  "requiresDuplicateDetection": {
                    "type": "boolean"
                  },
                  "supportOrdering": {
                    "type": "boolean"
                  },
                  "subscriptions": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "autoDeleteOnIdle": {
                              "type": "string"
                            },
                            "deadLetteringOnFilterEvaluationExceptions": {
                              "type": "boolean"
                            },
                            "deadLetteringOnMessageExpiration": {
                              "type": "boolean"
                            },
                            "defaultMessageTimeToLive": {
                              "type": "string"
                            },
                            "enableBatchedOperations": {
                              "type": "boolean"
                            },
                            "forwardDeadLetteredMessagesTo": {
                              "type": "string"
                            },
                            "forwardTo": {
                              "type": "string"
                            },
                            "lockDuration": {
                              "type": "string"
                            },
                            "maxDeliveryCount": {
                              "type": "integer"
                            },
                            "requiresSession": {
                              "type": "boolean"
                            },
                            "correlationFilter": {
                              "type": "object",
                              "properties": {
                                "contentType": {
                                  "type": "string"
                                },
                                "correlationId": {
                                  "type": "string"
                                },
                                "label": {
                                  "type": "string"
                                },
                                "messageId": {
                                  "type": "string"
                                },
                                "replyTo": {
                                  "type": "string"
                                },
                                "replyToSessionId": {
                                  "type": "string"
                                },
                                "sessionId": {
                                  "type": "string"
                                },
                                "to": {
                                  "type": "string"
                                },
                                "properties": {
                                  "type": "object",
                                  "additionalProperties": {
                                    "type": "string"
                                  }
                                }
                              },
                              "additionalProperties": false,
                              "minProperties": 1
                            }
                          },
                          "required": [
                            "name"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  },
  "required": [
    "environment"
  ],
  "title": "Values",
  "type": "object"
}
