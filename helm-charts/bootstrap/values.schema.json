{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "azure": {
      "type": "object",
      "required": [
        "location"
      ]
    },
    "environment": {
      "type": "string"
    },
    "ipaffsConfig": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "secretStore": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "refreshInterval": {
          "type": "string"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretKey": {
                "type": "string"
              },
              "remoteKey": {
                "type": "string"
              }
            },
            "required": [
              "secretKey",
              "remoteKey"
            ]
          }
        },
        "certs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretKey": {
                "type": "string"
              },
              "remoteKey": {
                "type": "string"
              }
            },
            "required": [
              "secretKey",
              "remoteKey"
            ]
          }
        }
      }
    },
    "project": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "serviceBus": {
      "type": "object",
      "properties": {
        "queues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "subscriptions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingressPorts",
        "sameNamespaceIngressPorts",
        "egressPorts",
        "dns"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressPorts": {
          "$ref": "#/definitions/networkPolicyPorts"
        },
        "sameNamespaceIngressPorts": {
          "$ref": "#/definitions/networkPolicyPorts"
        },
        "egressPorts": {
          "$ref": "#/definitions/networkPolicyPorts"
        },
        "dns": {
          "type": "object",
          "required": [
            "namespace",
            "podLabels"
          ],
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "environment"
  ],
  "title": "Values",
  "type": "object",
  "definitions": {
    "networkPolicyPorts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    }
  }
}
