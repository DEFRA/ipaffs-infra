{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "azure": {
      "type": "object",
      "required": [
      ]
    },
    "database": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "databaseNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "managedDatabaseNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "referencedDatabaseNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "image": {
      "type": "string"
    },
    "imageRegistry": {
      "type": "string"
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "java": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "canonicalNamespace": {
              "type": "string"
            },
            "jmxMetrics": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metricIntervalSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "manifestTag": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "hosts"
      ]
    },
    "ports": {
      "type": "object",
      "properties": {
        "service": {
          "type": "integer"
        },
        "container": {
          "type": "integer"
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "enabled"
      ]
    },
    "serviceBus": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "useSecrets": {
          "type": "boolean"
        },
        "connectionStringSecretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "connectionStringAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    }
  },
  "required": [
    "environment"
  ],
  "title": "Values",
  "type": "object"
}
