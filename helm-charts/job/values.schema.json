{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "properties": {
    "service": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "imageRegistry": {
      "type": "string"
    },
    "deployment": {
      "type": "object",
      "properties": {
        "manifestTag": {
          "type": "string"
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "serviceBus": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "databaseNames",
        "connectionStringSecretKey",
        "connectionStringAliases"
      ],
      "properties": {
        "databaseNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "connectionStringSecretKey": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "connectionStringAliases": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        }
      }
    },
    "azure": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string"
        },
        "managedIdentityName": {
          "type": "string"
        }
      }
    },
    "schedule": {
      "type": "string"
    },
    "concurrencyPolicy": {
      "type": "string",
      "enum": [
        "Allow",
        "Forbid",
        "Replace"
      ]
    },
    "successfulJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "failedJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "suspend": {
      "type": "boolean"
    },
    "keda": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "maxReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              },
              "authenticationRef": {
                "type": "object"
              }
            },
            "required": [
              "type",
              "metadata"
            ]
          }
        }
      }
    },
    "container": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "imagePullPolicy": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "initContainer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "config": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    }
  },
  "required": [
    "environment"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "keda": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "keda"
        ]
      },
      "then": {
        "properties": {
          "keda": {
            "properties": {
              "triggers": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "schedule"
        ]
      }
    }
  ]
}
