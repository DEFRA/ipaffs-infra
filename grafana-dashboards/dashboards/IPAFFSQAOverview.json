    {
      "id": 15,
      "type": "table",
      "title": "Pod restarts by service",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor-oob"
      },
      "description": "Services whose pods restarted within the selected range, with last restart time. Reason shown only when actionable (OOMKilled, BackoffLimitExceeded, Evicted, etc.); blank = restarted but no actionable reason recorded (see Recent errors / logs). Empty table = no restarts. Always shows the last 15 days.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last restarted"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Last restarted",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor-oob"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "/subscriptions/$subscription/resourceGroups/$resourceGroup/providers/Microsoft.OperationalInsights/workspaces/$workspace"
            ],
            "query": "let meaningful = dynamic([\"OOMKilled\",\"Evicted\",\"DeadlineExceeded\",\"BackoffLimitExceeded\",\"ContainerCannotRun\",\"CrashLoopBackOff\",\"ImagePullBackOff\",\"ErrImagePull\",\"CreateContainerConfigError\",\"CreateContainerError\",\"OOMKilling\",\"Preempted\",\"FailedScheduling\"]);\nlet restarts =\n  KubePodInventory\n  | where $__timeFilter(TimeGenerated)\n  | where Namespace == \"$namespace\"\n  | summarize ContainerRestartCount = max(ContainerRestartCount) by Name, TimeGenerated\n  | order by Name asc, TimeGenerated asc\n  | serialize\n  | extend prevRc = prev(ContainerRestartCount), prevName = prev(Name)\n  | where Name == prevName and ContainerRestartCount > prevRc\n  | extend Service = extract(\"^(.+)-[^-]+-[^-]+$\", 1, Name)\n  | summarize Restarts = sum(ContainerRestartCount - prevRc), [\"Last restarted\"] = max(TimeGenerated) by Service;\nlet statusReason =\n  KubePodInventory\n  | where $__timeFilter(TimeGenerated)\n  | where Namespace == \"$namespace\"\n  | extend Service = extract(\"^(.+)-[^-]+-[^-]+$\", 1, Name), r = tostring(parse_json(ContainerLastStatus).reason)\n  | where r in (meaningful)\n  | summarize arg_max(TimeGenerated, r) by Service\n  | project Service, StatusReason = r;\nlet eventReason =\n  KubeEvents\n  | where $__timeFilter(TimeGenerated)\n  | where Namespace == \"$namespace\"\n  | where Reason in (meaningful)\n  | extend Service = iff(Name matches regex \"-[0-9]{5,}$\", extract(\"^(.+)-[0-9]+$\", 1, Name), extract(\"^(.+)-[^-]+-[^-]+$\", 1, Name))\n  | where isnotempty(Service)\n  | summarize arg_max(TimeGenerated, Reason) by Service\n  | project Service, EventReason = Reason;\nrestarts\n| join kind=leftouter statusReason on Service\n| join kind=leftouter eventReason on Service\n| extend Reason = case(isnotempty(StatusReason), StatusReason, isnotempty(EventReason), EventReason, \"\")\n| project Service, Restarts, [\"Last restarted\"], Reason\n| order by [\"Last restarted\"] desc",
            "resultFormat": "table"
          }
        }
      ],
      "timeFrom": "15d"
    },
