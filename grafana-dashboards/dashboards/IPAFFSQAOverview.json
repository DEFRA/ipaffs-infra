      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor-oob"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "/subscriptions/$subscription/resourceGroups/$resourceGroup/providers/Microsoft.Insights/components/$resource"
            ],
            "query": "requests\n| where $__timeFilter(timestamp)\n| where url !contains \"/admin/health-check\"\n| summarize p90ms = percentile(duration, 90), requests = count() by service = cloud_RoleName, endpoint = name\n| where p90ms > 1000\n| project service, endpoint, p90_seconds = round(p90ms/1000.0, 2), requests\n| order by p90_seconds desc\n| take 100",
            "resultFormat": "table"
          }
        }
      ],
      "description": "Request endpoints whose 90th-percentile latency exceeds 1s, with their service and request count. Health-check probes excluded."
